# Chép thành tools/mkt/.env (file .env không commit). Chỉ cần điền phần cho tool bạn định chạy.

# ---- Chung ----
STEAM_URL=                     # https://store.steampowered.com/app/<APPID>/  (điền ngay khi page live)
STEAM_APPID=                   # hoặc chỉ APPID
FALLBACK_URL=https://team41.itch.io/sfc
WEB_URL=https://nghuylychee.github.io/FootballChaotic/
LINK_DOMAIN=                   # domain ngắn của link router, vd. sfc.gg (sau khi deploy Worker)
CAMPAIGN=prelaunch             # utm_campaign mặc định cho link sinh ra lúc này
DISCORD_URL=https://discord.gg/REPLACE_ME
CONTACT_EMAIL=                 # email liên hệ in trong press kit / mail

# ---- Twitch (tool tìm streamer) — dev.twitch.tv/console > Register Your Application (Client Credentials, miễn phí) ----
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---- Kick (tùy chọn) — kick.com/settings/developer ----
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# ---- Google: YouTube Data / YouTube Analytics / Gmail ----
# console.cloud.google.com > tạo project > bật "YouTube Data API v3", "YouTube Analytics API", "Gmail API"
# > OAuth consent screen (External, thêm email team làm test user) > Credentials > OAuth client ID, loại "Desktop app"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=               # API key (chỉ cần cho tìm kênh; upload / analytics dùng OAuth ở trên)

# ---- Gửi mail outreach: chọn một ----
MAIL_FROM="Team41 <hello@yourdomain.com>"
MAIL_REPLY_TO=
MAIL_VIA=dryrun                # dryrun | resend | gmail | smtp
RESEND_API_KEY=                # resend.com (100 mail/ngày miễn phí, cần xác minh domain)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_DAILY_CAP=50              # trần mail/ngày để không vào spam

# ---- TikTok Content Posting API (cần app được duyệt; để trống = đăng tay) ----
TIKTOK_ACCESS_TOKEN=
# ---- Instagram Graph API (tài khoản Business + Facebook app; để trống = đăng tay) ----
IG_USER_ID=
IG_ACCESS_TOKEN=

# ---- Steam (tùy chọn, phát key tự động) ----
# Key Steam phát tay: dán vào tools/mkt/data/keys.txt, mỗi dòng một key
