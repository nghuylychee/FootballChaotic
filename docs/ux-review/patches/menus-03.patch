diff --git a/css/style.css b/css/style.css
index 67ef4fd..1d1bed4 100644
--- a/css/style.css
+++ b/css/style.css
@@ -2354,6 +2354,10 @@ button.eq-row:hover b { color: var(--gold); }
 .tr2-zone em { font-family: var(--px); font-style: normal; font-size: 7px; color: var(--gold); }
 .tr2-zone.on { opacity: 1; border-color: var(--gold); }
 .tr2-zone.on::after { content: ''; position: absolute; left: 50%; top: -6px; margin-left: -3px; border: 3px solid transparent; border-bottom-color: var(--gold); }
+/* số thưởng ACHIEVEMENTS chờ nhận (góc ALBUM, dòng ACHIEVEMENTS trong mục lục) — giống số trên nút cúp trang chủ */
+.tr2-zone .tr2-new, .tr2-idx .tr2-new { position: absolute; right: -7px; top: -7px; flex: none; min-width: 13px; height: 13px; padding: 0 2px; display: flex; align-items: center; justify-content: center;
+  font-style: normal; font-family: var(--px); font-size: 6px; color: var(--ink); background: var(--gold); box-shadow: 1px 1px 0 var(--ink); animation: pulse 0.8s steps(2) infinite; }
+.tr2-zone:has(.tr2-new) { opacity: 1; }
 /* kệ cúp: số dưới từng cúp (trên biển đồng) + dải chi tiết cúp đang chọn */
 .tr2-cup { position: absolute; transform: translateX(-50%); z-index: 3; display: inline-flex; align-items: center; gap: 3px; padding: 0 4px; height: 14px; cursor: pointer;
   background: rgba(18,12,22,0.85); border: 1px solid #4a3a2a; }
@@ -2400,6 +2404,8 @@ button.eq-row:hover b { color: var(--gold); }
 .tr2-idx span { display: flex; flex-direction: column; gap: 3px; }
 .tr2-idx em { font-style: normal; text-align: right; color: #7a6450; }
 .tr2-idx.on { background: #fff8e8; border-color: #6a3a1a; box-shadow: 2px 2px 0 #6a3a1a; }
+.tr2-idx { position: relative; }
+.tr2-big .ac-new { margin-left: 0; }
 /* bảng ghim: polaroid lưới 3 x 2 trong khung gỗ bần (20..432 px) + bảng phấn (460..624 px) */
 .tr2-cork { position: absolute; left: 26px; top: 58px; width: 398px; height: 280px; z-index: 3; display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(2, 1fr); gap: 10px; }
 .tr2-pol { position: relative; display: flex; flex-direction: column; gap: 3px; padding: 4px 4px 5px; cursor: pointer; text-align: left; background: #f4eee2; border: 0; box-shadow: 2px 2px 0 rgba(18,12,22,0.6); }
