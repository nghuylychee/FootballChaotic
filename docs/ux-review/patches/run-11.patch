+++ b/css/style.css
@@ -3022,6 +3022,21 @@ canvas.avatar.cel, canvas.avatar.big.cel { width: 128px; height: 128px; }   /* x
 .rm-newcores { display: flex; align-items: center; gap: 6px; margin-bottom: 8px; }
 .rm-newcores em { font-style: normal; font-family: var(--px); font-size: 6px; color: #6bff4f; letter-spacing: 1px; }
 .rm-newcores span { padding: 2px; background: var(--panel); border: 1px solid #6bff4f; }
+/* hết run: phần mang về (UX run-11) — chip có nhãn GOLD / CORE ROAD, thanh tiến độ tới Core kế (phần run này góp: vàng, chạy lên), Core mới kèm tên */
+.rm-bring { display: flex; align-items: stretch; justify-content: center; gap: 8px; margin: 2px 0 6px; }
+.rb-chip { display: grid; grid-template-columns: auto auto auto; align-items: center; justify-content: start; column-gap: 4px; row-gap: 3px; padding: 5px 8px;
+  background: #14161c; border: 1px solid var(--edge); box-shadow: 2px 2px 0 var(--ink); }
+.rb-chip em { font-style: normal; font-family: var(--px); font-size: 6px; letter-spacing: 1px; color: #c7ccd6; }
+.rb-chip b { font-family: var(--px); font-size: 9px; font-weight: normal; color: var(--gold); text-shadow: 1px 1px 0 var(--ink); }
+.rb-chip.road { min-width: 150px; border-color: var(--gold); }
+.rb-bar { grid-column: 1 / -1; position: relative; display: block; height: 6px; background: #2a2e38; border: 1px solid var(--ink); text-decoration: none; }
+.rb-bar s { position: absolute; top: 0; bottom: 0; left: 0; background: #8a8f9c; }
+.rb-bar s.new { background: var(--gold); transform-origin: left; animation: rbGrow 0.9s steps(9) 0.4s both; }
+@keyframes rbGrow { from { transform: scaleX(0); } }
+.rb-chip small { grid-column: 1 / -1; font-size: 11px; line-height: 1; color: var(--muted); }
+.rm-newcores .rn-c { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 0; background: none; border: none; }
+.rn-c i { display: flex; padding: 2px; background: var(--panel); border: 1px solid #6bff4f; }
+.rn-c b { font-weight: normal; font-size: 11px; line-height: 1; color: #e6dccb; max-width: 90px; text-align: center; }
 /* GOAT PATH (user 2026-10-26): dải đội hình trên map · SQUAD · màn chọn đồng đội · mốc SKILL GAME */
 .rm-strip { display: flex; align-items: center; gap: 6px; padding: 1px 6px; height: 26px; }
 .rm-strip:disabled { opacity: 1; cursor: default; }
