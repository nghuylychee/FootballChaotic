--- a/css/style.css
+++ b/css/style.css
@@ -637,6 +637,11 @@ canvas.avatar.cel, canvas.avatar.big.cel { width: 128px; height: 128px; }   /* x
 .pt-roomhead .pt-code b { font-size: 11px; letter-spacing: 2px; }
 .pt-code b { font-family: var(--px); font-size: 8px; font-weight: normal; color: var(--gold); letter-spacing: 1px; text-shadow: 1px 1px 0 var(--ink); }
 .pt-code:hover b { color: #fff; }
+/* chữ COPY cạnh mã phòng (cả dòng bấm được); phòng chưa đủ người: COPY nháy để chỉ việc cần làm */
+.pt-code i { font-style: normal; font-family: var(--px); font-size: 5px; letter-spacing: 1px; color: var(--ink); background: var(--gold); margin-left: 5px; padding: 2px 3px 1px; vertical-align: 2px; box-shadow: 1px 1px 0 var(--ink); }
+.pt-code:hover i { background: #fff; }
+.pt-code.wait i { animation: ptBlink 0.9s steps(2) infinite; }
+@keyframes ptBlink { 50% { background: #fff; } }
 /* phòng: chọn sân (chủ phòng ◀▶, người khác chỉ xem) */
 .pt-ground { display: flex; align-items: center; gap: 4px; font-size: 13px; color: #e6dccb; padding: 3px 6px 2px; background: var(--panel); border: 1px solid var(--edge); box-shadow: 2px 2px 0 var(--ink); line-height: 1; }
 .pt-ground u { text-decoration: none; color: var(--muted); margin-right: 2px; }
@@ -684,6 +689,10 @@ canvas.avatar.cel, canvas.avatar.big.cel { width: 128px; height: 128px; }   /* x
 .pt-bench span { font-size: 11px; color: var(--muted); }
 .pt-note { font-size: 12px; color: var(--muted); text-align: center; line-height: 1; }
 .pt-note.ok { color: #9dff3d; animation: pulse 0.8s steps(2) infinite; }
+/* chủ phòng chưa START được: lý do + việc cần làm (vàng); bấm START lúc đó -> rung */
+.pt-note.need { font-size: 13px; color: var(--gold); }
+.pt-note.nudge { animation: ptNudge 0.3s steps(4); }
+@keyframes ptNudge { 25% { transform: translateX(-4px); } 75% { transform: translateX(4px); } }
 /* bảng chọn đồng đội AI (ô AI của mình trong phòng): đội hình + SWAP POSITION */
 .pt-pop { position: absolute; inset: 0; z-index: 5; display: flex; align-items: center; justify-content: center; background: rgba(10, 11, 14,0.55); }
 .pt-popbox { width: 190px; display: flex; flex-direction: column; gap: 2px; padding: 6px; background: rgba(14,16,20,0.97); border: 1px solid var(--gold); box-shadow: 3px 3px 0 var(--ink); }
