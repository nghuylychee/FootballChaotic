diff --git a/css/style.css b/css/style.css
--- a/css/style.css
+++ b/css/style.css
@@ -1966,6 +1966,26 @@
 .tr-bonus div.on { color: #e6dccb; }
 .tr-bonus div.on b { color: var(--gold); }
 .pb-cards { display: flex; gap: 6px; }
+/* Pause · dải "trận này" (matchui.js pauseMatch): luật sân · LEGEND · BADGE đội, 1 hàng gọn giữa bảng build và hàng nút */
+.pause-match { display: flex; gap: 6px; margin-top: 4px; width: 100%; max-width: 538px; align-items: stretch; }
+.pm-box { display: flex; flex-direction: column; justify-content: center; gap: 2px; min-width: 0; padding: 3px 6px 4px; background: var(--panel); border: 1px solid var(--edge); }
+.pm-box h5 { display: flex; align-items: center; gap: 4px; margin: 0; font-family: var(--px); font-size: 6px; font-weight: normal; line-height: 1; letter-spacing: 1px; color: var(--muted); white-space: nowrap; }
+.pm-box > div { display: flex; align-items: center; gap: 4px; }
+.pm-rule { flex: 1 1 0; border-left: 2px solid var(--c); }
+.pm-rule p { margin: 0; font-size: 12px; line-height: 1; color: #c7ccd6; }
+.pm-rule p b { font-family: var(--px); font-size: 6px; font-weight: normal; letter-spacing: 1px; color: var(--c); text-shadow: 1px 1px 0 var(--ink); margin-right: 2px; white-space: nowrap; }
+.pm-rule p b .pxi { vertical-align: -2px; margin-right: 3px; }
+/* phòng online (thêm dòng "Online matches keep running"): bớt khoảng trên để dải không chạm hàng nút */
+#pause:has(.pause-match):has(.pause-note) .pause-title { margin-bottom: 6px; }
+#pause:has(.pause-match) .pause-note { margin: -4px 0 4px; }
+.pm-leg { flex: none; border-left: 2px solid var(--lc); }
+.pm-leg h5 { color: var(--lc); text-shadow: 1px 1px 0 var(--ink); }
+.pm-leg .lg-combo { gap: 4px; padding: 2px 5px 1px 3px; box-shadow: 1px 1px 0 var(--ink); }
+.pm-leg .lg-combo > b { font-size: 6px; }
+.pm-leg .lg-flaw { padding: 2px 4px 1px; font-size: 5px; }
+.pm-bds { flex: none; }
+.pm-bds > div { flex-wrap: wrap; gap: 2px; max-width: 120px; }
+.pm-bds .sq-b { width: 14px; height: 14px; }
 .mcard { position: relative; width: 80px; height: 74px; display: flex; flex-direction: column; align-items: center; padding: 3px 3px 2px; background: #1a1c22;
   border: 2px solid var(--t); box-shadow: 3px 3px 0 var(--ink), 0 0 6px color-mix(in srgb, var(--t) 35%, transparent); }
 .mcard::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 2px; background: var(--t); }
