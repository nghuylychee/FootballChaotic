+        out.push(`<div class="pm-box pm-bds"><h5>${esc(_t('TEAM BADGES'))}</h5><div>${icons}</div></div>`);
+      }
+      return out.length ? `<div class="pause-match">${out.join('')}</div>` : '';
+    },
+
     // đổi nút đang chọn mà không vẽ lại (giữ ảnh động của các lá Core)
     setPauseSel() {
