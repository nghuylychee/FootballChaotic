diff --git a/src/ui/hud.js b/src/ui/hud.js
index 44a6e89..3c2680f 100644
--- a/src/ui/hud.js
+++ b/src/ui/hud.js
@@ -353,9 +353,12 @@ window.SFC = window.SFC || {};
     },
 
     /* ================= THÔNG BÁO ================= */
-    banner(text, sub, color, dur = 1.8) {
-      const el = this.el.banner;
+    // top = đẩy banner lên sát dưới bảng tỉ số giữa HUD (banner GOAL!: máy quay ăn mừng phóng to người ghi bàn ngay giữa màn,
+    // banner ở chỗ cũ sẽ đè lên). Bảng tỉ số cao thấp tuỳ trận (Skill game / LEGEND TRIAL có thêm thanh mốc, phím) -> đo lúc hiện
+    banner(text, sub, color, dur = 1.8, top = false) {
+      const el = this.el.banner, hm = top && this.el.hud.querySelector('.hud-mid');
       el.innerHTML = `<div class="b-main" style="color:${color || '#fff'}">${esc(text)}</div>${sub ? `<div class="b-sub">${esc(sub)}</div>` : ''}`;
+      el.style.top = hm ? (hm.offsetTop + hm.offsetHeight + 4) + 'px' : '';
       el.classList.remove('show');
       void el.offsetWidth;
       el.classList.add('show');
