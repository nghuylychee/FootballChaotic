diff --git a/css/style.css b/css/style.css
index ddd2355..5d0446b 100644
--- a/css/style.css
+++ b/css/style.css
@@ -3335,6 +3335,20 @@ button.pk-slot.sel, button.pk-slot:hover { border-style: solid; border-color: va
 .pk-empty .sq-head { left: 0; right: 0; }
 .pk-empty .sq-head em { font-size: 7px; color: var(--muted); }
 .pk-sil canvas { width: 96px; height: 106px; image-rendering: pixelated; filter: brightness(0); opacity: 0.5; margin-top: 10px; }
+/* ô cần chọn kế tiếp (UX run-12): viền nét đứt vàng nhấp nháy + nhãn PICK */
+.pk-empty.next { border-color: var(--gold); animation: pkWait 1s steps(2) infinite; }
+.pk-empty.next .sq-head em { color: var(--gold); }
+@keyframes pkWait { 50% { border-color: #8a7a2a; background-color: rgba(255, 225, 79, 0.08); } }
+.pk-wait { position: absolute; left: 50%; bottom: 12px; transform: translateX(-50%); text-decoration: none; font-family: var(--px); font-size: 7px; letter-spacing: 1px; line-height: 1;
+  color: var(--ink); background: var(--gold); padding: 3px 5px 2px; border: 1px solid var(--ink); box-shadow: 1px 1px 0 var(--ink); }
+/* dòng hướng dẫn cạnh START RUN · START RUN chưa đủ người: mờ + vị trí còn thiếu (ô nét đứt) */
+.pk-mid .pk-todo { color: var(--gold); letter-spacing: 1px; white-space: nowrap; }
+.pk-todo::before { content: "▼ "; }
+.pk-todo.nag { color: #ff5a6e; animation: pkNag 0.12s steps(2) 3; }
+@keyframes pkNag { 50% { transform: translateX(-3px); } }
+.pk-mid { gap: 12px; }
+.pk-miss { display: inline-flex; gap: 3px; margin-left: 8px; font-style: normal; }
+.pk-miss i { font-style: normal; font-size: 6px; padding: 2px 3px 1px; border: 1px dashed currentColor; letter-spacing: 1px; }
 /* đang kéo: ô thả được sáng lên, ô đang trỏ viền vàng */
 .pk-page.dragging .pk-card:not(.lock), .pk-page.dragging .pk-bench { outline: 1px dashed rgba(255, 225, 79, 0.45); outline-offset: 2px; }
 .pk-page .over { outline: 2px solid var(--gold) !important; outline-offset: 2px; background-color: rgba(255, 225, 79, 0.08); }
