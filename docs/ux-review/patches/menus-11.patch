diff --git a/css/style.css b/css/style.css
index 1d1bed4..bc40f2b 100644
--- a/css/style.css
+++ b/css/style.css
@@ -2423,7 +2423,12 @@ button.eq-row:hover b { color: var(--gold); }
 .tr2-pol .tp-path i { flex: 1; height: 3px; background: linear-gradient(90deg, var(--ac) var(--w, 0%), #d8cfbc var(--w, 0%)); }
 .tr2-pol .tp-path i.boss { background: #ffd23f; }
 .tr2-pol .tp-path i:not(.on):not(.boss) { background: #d8cfbc; }
-.tr2-empty { grid-column: 1 / -1; grid-row: 1 / -1; display: flex; align-items: center; justify-content: center; opacity: 0.4; }
+.tr2-empty { grid-column: 1 / -1; grid-row: 1 / -1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; }
+.tr2-empty > .pxi { opacity: 0.4; }
+/* bảng ghim trống / kệ cúp chưa có: 1 câu nói cách lấp đầy (chỉ hiện khi trống) */
+.tr2-note { position: relative; max-width: 220px; padding: 6px 10px 5px; font-size: 14px; line-height: 1.1; text-align: center; color: #3a2a1e; background: #f4eee2; box-shadow: 2px 2px 0 rgba(18,12,22,0.6); transform: rotate(-1.5deg); }
+.tr2-note::before { content: ''; position: absolute; left: 50%; top: -3px; width: 6px; height: 6px; margin-left: -3px; background: #e0403a; box-shadow: 1px 1px 0 var(--ink); }
+.tr2-strip > .tr2-how { font-size: 13px; color: var(--muted); }
 .tr2-pg { position: absolute; right: 2px; top: -16px; font-family: var(--px); font-size: 6px; color: #f4eee2; }
 .tr2-chalk { position: absolute; left: 466px; top: 62px; width: 152px; height: 270px; z-index: 3; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: repeat(3, 1fr); gap: 8px; }
 .tr2-rec { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; border: 1px dashed rgba(232,236,245,0.25); }
