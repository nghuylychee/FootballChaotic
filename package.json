{
  "name": "street-football-chaos",
  "productName": "Street Football Chaos",
  "version": "1.0.1",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --dir",
    "manifest": "node scripts/manifest.js",
    "predist": "node scripts/manifest.js --check",
    "preitch-web": "node scripts/manifest.js --check",
    "preitch-desktop": "node scripts/manifest.js --check",
    "itch-web": "node scripts/build-web.js",
    "itch-desktop": "node scripts/build-itch.js",
    "serve": "node scripts/serve.js",
    "online": "node scripts/serve.js --online",
    "server": "node server/index.js",
    "server:test": "npm test --prefix server"
  },
  "dependencies": {
    "steamworks.js": "0.4.0"
  },
  "devDependencies": {
    "electron": "44.5.0",
    "electron-builder": "26.15.3",
    "terser": "5.51.2"
  },
  "build": {
    "appId": "com.streetfootballchaos.game",
    "productName": "Street Football Chaos",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "index.html",
      "css/**",
      "config/**",
      "src/**",
      "!src/dev/**",
      "assets/**",
      "lib/**",
      "electron/**",
      "!node_modules/steamworks.js/dist/{osx,linux64}/**"
    ],
    "electronLanguages": [
      "en-US",
      "vi"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/*.dll"
    ],
    "afterPack": "scripts/strip-dev.js",
    "win": {
      "target": "dir",
      "icon": "build/icon.ico"
    }
  }
}
